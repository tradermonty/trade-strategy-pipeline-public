# Alpaca Markets API (required for data acquisition and trading)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# FMP API (required for fundamental data)
FMP_API_KEY=your_fmp_api_key_here

# Finviz: no API key required (current implementation uses unauthenticated access)

# CI mode (set to 1 to disable all external API calls)
# CI_OFFLINE=1
